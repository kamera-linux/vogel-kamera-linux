# ============================================================
# Ansible – Persönliche Einstellungen (BEISPIEL)
# ============================================================
# Kopiere diese Datei zu .env und passe deine Werte an:
#
#   cp ansible/.env.example ansible/.env
#   nano ansible/.env         # (oder editor deiner Wahl)
#
# Die Datei ansible/.env wird NICHT ins Git eingecheckt (.gitignore).
# Sie enthält nur deine lokalen Zugangsdaten.
# ============================================================

# Raspberry Pi – Hostname (z.B. via mDNS) oder IP-Adresse
# Beispiele:
#   raspberry-pi.local    ← mDNS (empfohlen, wenn avahi-daemon läuft)
#   192.168.1.100         ← statische IP
#   vogel-kamera          ← eigener Eintrag in /etc/hosts
PI_HOST=raspberry-pi.local

# Raspberry Pi – SSH-Benutzername
# Standard bei Raspberry Pi OS: pi
PI_USER=pi

# Lokaler Pfad zum SSH-Private-Key für den Pi
# Neuen Key erstellen:  ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa_pi
# Key übertragen:       ssh-copy-id -i ~/.ssh/id_rsa_pi pi@raspberry-pi.local
PI_SSH_KEY=~/.ssh/id_rsa_pi

# Pfad zur Datei mit dem Ansible-Vault-Passwort (wird lokal erzeugt)
# Einmalig anlegen: echo 'MeinVaultPasswort' > ~/.pi-daemon-vault-pass && chmod 600 ~/.pi-daemon-vault-pass
VAULT_PASS_FILE=~/.pi-daemon-vault-pass
