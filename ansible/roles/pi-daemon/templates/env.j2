# Jinja2-Template → {{ pi_daemon_dir }}/.env
# Secrets kommen aus ansible-vault (vault.yml)
PI_DAEMON_PORT={{ pi_daemon_port }}
PI_DAEMON_CERT_FILE=/certs/cert.pem
PI_DAEMON_KEY_FILE=/certs/key.pem
PI_DAEMON_JWT_SECRET={{ vault_pi_daemon_jwt_secret }}
PI_DAEMON_TOTP_SECRET={{ vault_pi_daemon_totp_secret }}
PI_DAEMON_TOKEN_EXPIRY_HOURS={{ pi_token_expiry_h }}
PI_DAEMON_VIDEO_DIR=/videos
PI_DAEMON_DETECTION_SCRIPT={{ pi_detection_script }}
