# Jinja2-Template → /etc/pi-daemon/app.env (env_file des Containers)
# Secrets kommen aus ansible-vault (vault.yml)
PI_DAEMON_PORT={{ pi_daemon_port }}
PI_DAEMON_CERT_FILE=/certs/cert.pem
PI_DAEMON_KEY_FILE=/certs/key.pem
PI_DAEMON_JWT_SECRET={{ vault_pi_daemon_jwt_secret }}
PI_DAEMON_TOTP_SECRET={{ vault_pi_daemon_totp_secret }}
PI_DAEMON_TOKEN_EXPIRY_HOURS={{ pi_token_expiry_h }}
PI_DAEMON_VIDEO_DIR=/videos
PI_DAEMON_DETECTION_SCRIPT={{ pi_detection_script }}
PI_DAEMON_POWERBANK_MAC={{ pi_powerbank_mac | default('') }}
PI_DAEMON_POWERBANK_INTERVAL={{ pi_powerbank_interval | default(60) }}
PI_DAEMON_POWERBANK_WARN_PERCENT={{ pi_powerbank_warn_percent | default(10) }}
PI_DAEMON_POWERBANK_SHUTDOWN_PERCENT={{ pi_powerbank_shutdown_percent | default(5) }}
PI_DAEMON_METRICS_TOKEN={{ pi_metrics_token | default('') }}
PI_DAEMON_GRAFANA_URL={{ pi_grafana_url | default('') }}
PI_DAEMON_GRAFANA_PORT={{ pi_grafana_port if (pi_monitoring | default(false) | bool) else 0 }}
PI_DAEMON_MIN_FREE_GB={{ pi_min_free_gb | default(0) }}
