# Jinja2-Template → {{ pi_daemon_dir }}/docker-compose.yml
# Ansible-Variablen in Doppel-Klammern werden ersetzt.
# Docker-Compose-Variablen werden als literale Werte eingetragen.
services:
  pi-daemon:
    image: {{ pi_daemon_image }}:{{ pi_daemon_image_tag }}
    container_name: pi-daemon
    restart: on-failure:5
    # Restart-Policy: Versucht bis zu 5 Mal neu zu starten, dann stoppt.
    # Wird kombiniert mit systemd-Service (on-failure + StartLimitBurst) für zusätzliche Resilienz

    ports:
      - "{{ pi_daemon_port }}:{{ pi_daemon_port }}"

    # Privilegierter Modus: Gibt vollen Zugriff auf ALLE Host-Devices (/dev/videoN, /dev/media*, etc.)
    # und entfernt masked paths (/sys/firmware/devicetree ist für rpicam-apps sichtbar).
    # Akzeptabel für eine dedizierte, nicht-multi-tenant Raspberry-Pi-Kamera.
    privileged: true

    # Kernel-UEvents für libcamera
    volumes:
      - {{ pi_video_dir }}:/videos
      - /etc/pi-daemon:/config         # beschreibbar: sync-config.json + SSH-Key
      - {{ pi_certs_dir }}:/certs:ro
      - /run/udev:/run/udev:ro
      - /proc:/proc:ro                 # psutil braucht /proc
      - /sys/bus/i2c:/sys/bus/i2c      # Kamera-Reset via imx708 sysfs (unbind/bind)
      # rpicam-apps: Binary + Libraries vom Pi-Host einbinden (kein apt-Install nötig)
      - /usr/bin/rpicam-vid:/opt/rpicam-vid:ro              # Binary (Wrapper in /usr/local/bin/rpicam-vid)
      - /usr/bin/rpicam-hello:/opt/rpicam-hello:ro          # rpicam-hello für Hailo-NPU Detection
      - /usr/bin/rpicam-still:/opt/rpicam-still:ro          # rpicam-still für Snapshot-Aufnahmen
      - /usr/bin/hailortcli:/usr/bin/hailortcli:ro          # Hailo CLI für NPU-Status (fw-version)
      - /usr/lib/libhailort.so.4.23.0:/usr/lib/libhailort.so.4.23.0:ro  # Hailo Runtime Library (versionierte .so, Trixie-kompatibel)
      - /usr/share/rpi-camera-assets:/usr/share/rpi-camera-assets:ro  # Hailo HEF-JSON-Modelle (hailo_yolov8_inference.json etc.)
      - /lib/aarch64-linux-gnu:/host/lib:ro                  # Pi-spezifische Trixie-Libs (libcamera, libpisp ...)
      - /usr/lib/aarch64-linux-gnu:/host/usr/lib:ro            # Weitere Trixie-Libs (libav/ffmpeg H.264-Codec etc.)
      - /usr/lib/aarch64-linux-gnu/rpicam-apps-postproc:/usr/lib/aarch64-linux-gnu/rpicam-apps-postproc:ro  # Hailo/OpenCV Post-Processing-Plugins (hardcodierter Pfad in librpicam_app.so)
      - /usr/lib/libhailort.so:/usr/lib/libhailort.so:ro                                    # Hailo Runtime Library Symlink (→ libhailort.so.4.23.0)
      - /usr/lib/aarch64-linux-gnu/hailo:/usr/lib/aarch64-linux-gnu/hailo:ro                # Hailo Tappas Post-Process-Libs (libyolo_hailortpp_post.so etc.)
      - /usr/share/hailo-models:/usr/share/hailo-models:ro                                  # Hailo HEF-Modell-Dateien (yolov8s_h8.hef etc.)
      - /usr/lib/aarch64-linux-gnu/rpicam-apps-encoder:/usr/lib/aarch64-linux-gnu/rpicam-apps-encoder:ro  # H.264-Encoder-Plugin
      - /usr/lib/aarch64-linux-gnu/pulseaudio:/host/usr/lib/pulseaudio:ro  # libpulsecommon für libav-encoder
      - /usr/lib/aarch64-linux-gnu/libcamera:/usr/lib/aarch64-linux-gnu/libcamera:ro  # libcamera IPA-Module
      - /usr/share/libpisp:/usr/share/libpisp:ro             # libpisp-Konfigurationsdateien
      - /usr/share/libcamera:/usr/share/libcamera:ro         # libcamera IPA-Tuning-/Config-Dateien (imx708_wide.json etc.)
      - /dev/dma_heap:/dev/dma_heap                          # DMA-Heap inkl. vidbuf_cached-Symlink (fehlt sonst im Container)
      - /usr/lib/python3/dist-packages:/usr/lib/python3/dist-packages:ro  # picamera2 + libcamera + numpy Python-Bindings (Trixie System-Pakete)
      # Host-Python 3.13 (Trixie) für Detection-Script – gleiche glibc wie libcamera/picamera2
      - /usr/bin/python3.13:/opt/python3-host:ro                          # Host Python 3.13 Binary
      - /usr/lib/python3.13:/usr/lib/python3.13:ro                        # Host Python 3.13 Stdlib
      - /home/roimme/.local/lib/python3.13/site-packages:/opt/host-site-packages:ro  # cv2 + ultralytics
      - /usr/lib:/host/usr/lib2:ro                                        # Weitere Trixie-Libs (z.B. libarmadillo)
      - /home/roimme/vogel-kamera-linux/raspberry-pi-scripts/yolov8n.pt:/home/roimme/vogel-kamera-linux/raspberry-pi-scripts/yolov8n.pt:ro  # YOLO Model

    env_file:
      - /etc/pi-daemon/app.env

    # bcrypt-Hash separat: $ muss als $$ escaped werden, damit Docker Compose
    # sie nicht als Variablen-Expansion interpretiert.
    # vault_pi_daemon_password_hash = "$2b$12$<53chars>" → Template schreibt "$$2b$$12$$<53chars>"
    environment:
      TZ: Europe/Berlin
      PI_DAEMON_PASSWORD_HASH: $$2b$$12$${{ vault_pi_daemon_password_hash | replace('$2b$12$', '') }}      # Gotify Alert-Konfiguration (self-hosted, open-source)
      GOTIFY_URL: "{{ pi_daemon_gotify_url | default('') }}"
      GOTIFY_TOKEN: "{{ pi_daemon_gotify_token | default('') }}"
    # tmpfs für schnelle Temp-Dateien
    tmpfs:
      - /tmp:size=256m

    # ── Health-Check: Prüft alle 30s ob Daemon noch reagiert ────────────────────────
    # Wird von Docker genutzt um "on-failure:5" zu triggern.
    # Gibt Health-Status an systemd via "docker ps" oder Logs.
    # OPTIMIERT: Timeout 10s (SSL-Handshake Zeit), Interval 60s (Cache läuft alle 2s im Daemon),
    # Start-Period 30s (Boot-Zeit), Retries 5 (toleranter gegenüber kurzen Blips)
    healthcheck:
      test: |
        python3 -c "
        import urllib.request, ssl, sys
        try:
          ctx = ssl.create_default_context()
          ctx.check_hostname = False
          ctx.verify_mode = ssl.CERT_NONE
          urllib.request.urlopen('https://localhost:8443/api/health', context=ctx, timeout=10)
          sys.exit(0)
        except Exception as e:
          print(f'Health-Check fehlgeschlagen: {e}')
          sys.exit(1)
        "
      interval: 60s
      timeout: 10s
      retries: 5
      start_period: 30s

    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
        labels: "service=pi-daemon"
