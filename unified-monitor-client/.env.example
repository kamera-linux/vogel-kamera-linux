# SSH-Konfiguration für Unified Monitor Client
# Kopiere diese Datei zu .env und fülle deine Werte ein
#
# 🚀 Quick Setup:
#    1. Kopieren: cp .env.example .env
#    2. Bearbeiten: nano .env
#    3. Setup starten: ./setup_environment.sh

# ============================================================================
# 🔐 SSH-VERBINDUNG (für Remote Raspberry Pi)
# ============================================================================

# SSH-Schlüssel (absoluter Pfad zum Private-Key)
# Generieren: ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa_pi
SSH_KEY=~/.ssh/id_rsa_pi

# SSH-Benutzername auf dem Raspberry Pi (Standard: pi)
SSH_USER=pi

# Hostname oder IP des Raspberry Pi
# Beispiele: 
#   - raspberry-pi.local (mDNS)
#   - 192.168.1.100 (statische IP)
#   - vogel-pi (falls in /etc/hosts eingetragen)
SSH_HOST=raspberry-pi.local

# ============================================================================
# 📁 REMOTE PFADE (auf dem Raspberry Pi)
# ============================================================================

# Basisverzeichnis des Repositories
REMOTE_REPO_DIR=/home/pi/vogel-kamera-linux

# Pfad zu den Skripten
REMOTE_SCRIPT_DIR=/home/pi/vogel-kamera-linux/raspberry-pi-scripts

# Basis-Videoordner
REMOTE_VIDEO_BASE=/home/pi/Videos/Vogelhaus

# ============================================================================
# 🎯 AUFNAHME-PARAMETER
# ============================================================================

# AI-Erkennungs-Schwelle (0.0-1.0, Default: 0.5)
# Höher = strengere Erkennungen, weniger False Positives
DEFAULT_THRESHOLD=0.5

# Cooldown zwischen Aufnahmen in Sekunden (Default: 15)
DEFAULT_COOLDOWN=15

# Mindest-Dauer für Trigger in Sekunden (Default: 1.0)
DEFAULT_TRIGGER_DURATION=1.0

# Audio-Trigger-Schwelle (Default: 0.3)
DEFAULT_AUDIO_THRESHOLD=0.3

# ============================================================================
# 📊 MONITORING
# ============================================================================

# Status-Report Interval in Sekunden (Default: 300 = 5 Min)
STATUS_INTERVAL=300

# Video-Watcher Interval in Sekunden (Default: 15)
VIDEO_WATCH_INTERVAL=15

# Nur Videos der letzten X Tage beachten (Default: 7)
RECENT_DAYS=7
