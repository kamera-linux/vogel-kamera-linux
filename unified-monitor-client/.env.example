# SSH-Konfiguration für Unified Monitor Client
# TEMPLATE: Kopiere diese Datei zu .env und passe deine Werte ein!
#
# 🚀 Quick Setup:
#    1. Kopieren: cp .env.example .env
#    2. Bearbeiten: nano .env
#    3. Passe SSH_USER, SSH_HOST, SSH_KEY an!

# ============================================================================
# 🔐 SSH-VERBINDUNG (erforderlich)
# ============================================================================

# SSH-Schlüssel (absoluter oder expandierter Pfad zum Private-Key)
# Generieren: ssh-keygen -t rsa -b 4096 -f ~/.ssh/id_rsa_pi
SSH_KEY=~/.ssh/id_rsa_pi

# SSH-Benutzername auf dem Raspberry Pi
# Standard-Benutzer: pi (Raspberry Pi OS)
SSH_USER=pi

# Hostname oder IP des Raspberry Pi
# Beispiele: 
#   raspberry-pi.local  (mDNS - Empfohlen!)
#   192.168.1.100       (Statische IP)
#   vogel-pi            (Falls in /etc/hosts eingetragen)
SSH_HOST=raspberry-pi.local

# SSH-Port (Standard: 22)
SSH_PORT=22

# ============================================================================
# 📝 HINWEISE
# ============================================================================
# • Diese Datei wird NICHT synchronisiert (.gitignore)
# • Alle Remote-Pfade werden automatisch konstruiert basierend auf SSH_USER
#   Beispiel: /home/{SSH_USER}/vogel-kamera-linux
# • Für Custom-Konfiguration: Bearbeite config.py (auch in .gitignore)

# Status-Report Interval in Sekunden (Default: 300 = 5 Min)
STATUS_INTERVAL=300

# Video-Watcher Interval in Sekunden (Default: 15)
VIDEO_WATCH_INTERVAL=15

# Nur Videos der letzten X Tage beachten (Default: 7)
RECENT_DAYS=7
