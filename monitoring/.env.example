# Kopieren nach .env (wird nicht eingecheckt) und anpassen.

# Grafana-Login "admin" mit diesem Passwort
GRAFANA_ADMIN_PASSWORD=

# Port der Grafana-Oberfläche auf diesem Rechner
# (3002, damit es nicht mit dem Modellbahn-Monitoring auf 3001 kollidiert)
GRAFANA_PORT=3002

# Prometheus-Oberfläche, nur lokal erreichbar
PROMETHEUS_PORT=9091

# Wie lange Messwerte aufbewahrt werden (was zuerst greift)
PROMETHEUS_RETENTION=180d
PROMETHEUS_RETENTION_SIZE=2GB

TZ=Europe/Berlin
